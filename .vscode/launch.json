{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "arta (Flutter)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "arta-backend",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (App + Server)",
            "configurations": ["arta-backend", "arta (Flutter)"]
        }
    ]
}